<%- include('./partials/header') %>

<div class="pt-24"></div>

<div class="min-h-[calc(100vh-160px)] flex-1 bg-[#FAFAFA] flex items-center justify-center px-6 py-12">

    <div class="w-full max-w-md">

        <!-- Login Card -->
        <div class="bg-white rounded-3xl border border-zinc-200/80 shadow-xl p-8 md:p-10">

            <!-- Heading -->
            <div class="text-center mb-8">

                <div class="w-14 h-14 mx-auto rounded-2xl bg-zinc-900 text-white flex items-center justify-center text-2xl mb-4 shadow-md">
                    <i class="ri-shield-user-line"></i>
                </div>

                <h2 class="text-3xl font-bold text-zinc-900">
                    Admin Portal
                </h2>

                <p class="text-zinc-500 text-sm mt-2">
                    Sign in to manage inventory, catalog, and store settings.
                </p>

            </div>

            <!-- Login Form -->
            <form autocomplete="off" action="/owners/login" method="post" class="space-y-4">

                <div>
                    <label class="block text-xs font-semibold text-zinc-600 uppercase tracking-wider mb-2">
                        Admin Email
                    </label>

                    <input
                        autocomplete="email"
                        class="w-full bg-zinc-50 px-4 py-3.5 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm transition"
                        type="email"
                        placeholder="admin@scatch.com"
                        name="email"
                        required>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-zinc-600 uppercase tracking-wider mb-2">
                        Password
                    </label>

                    <input
                        autocomplete="current-password"
                        class="w-full bg-zinc-50 px-4 py-3.5 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm transition"
                        type="password"
                        placeholder="Enter admin password"
                        name="password"
                        required>
                </div>

                <button
                    type="submit"
                    class="w-full py-4 bg-zinc-900 text-white rounded-xl font-medium hover:bg-black transition shadow-md cursor-pointer text-sm">
                    Sign In to Dashboard
                </button>

            </form>

            <!-- Security Notice: No web creation allowed -->
            <div class="mt-6 p-3.5 bg-zinc-50 border border-zinc-200/80 rounded-2xl text-xs text-zinc-500 space-y-1">
                <div class="flex items-center gap-1.5 font-semibold text-zinc-700">
                    <i class="ri-lock-2-line text-sm"></i>
                    <span>Restricted Access</span>
                </div>
                <p>
                    Admin accounts cannot be registered via the web app. Authorized administrators are provisioned directly on the server via CLI.
                </p>
            </div>

            <!-- Back to Store -->
            <div class="mt-6 text-center">
                <a href="/shop" class="text-xs text-zinc-400 hover:text-zinc-600 transition flex items-center justify-center gap-1">
                    <i class="ri-arrow-left-line"></i>
                    Return to Customer Store
                </a>
            </div>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>