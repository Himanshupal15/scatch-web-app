<%- include('./partials/header') %>

<div class="pt-24"></div>

<div class="w-full flex-1 bg-[#FAFAFA] px-6 lg:px-16 py-10">

    <div class="flex justify-between items-center mb-8">
        <a href="/shop" class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-5 py-2.5 text-sm font-medium text-zinc-700 hover:bg-zinc-100 transition">
            <i class="ri-arrow-left-line"></i>
            Continue shopping
        </a>
    </div>

    <% const cartHasProducts = user.cart && user.cart.some(function(item){ return item && item.product; }); %>

    <% if (!cartHasProducts) { %>
        <div class="max-w-2xl mx-auto bg-white rounded-3xl border border-zinc-200/80 shadow-sm p-12 text-center my-10">
            <div class="w-20 h-20 mx-auto rounded-full bg-zinc-100 flex items-center justify-center text-zinc-400 text-3xl mb-5">
                <i class="ri-shopping-bag-3-line"></i>
            </div>
            <h2 class="text-3xl font-bold text-zinc-900 mb-3">Your cart is empty</h2>
            <p class="text-zinc-500 mb-8 text-base">Looks like you haven't added any luxury bags to your cart yet.</p>
            <a href="/shop" class="inline-flex items-center gap-2 rounded-full bg-zinc-900 px-8 py-3.5 text-white font-medium hover:bg-black transition shadow-md">
                <i class="ri-shopping-bag-line"></i>
                Start Shopping
            </a>
        </div>
    <% } else { %>
        <div class="flex flex-col lg:flex-row gap-10">

            <!-- Cart Items List -->
            <div class="lg:w-[68%] space-y-6">

                <% user.cart.forEach(function(item){ %>
                    <% if (!item || !item.product) return; %>

                    <div class="bg-white rounded-3xl border border-zinc-200/70 shadow-sm hover:shadow-md transition p-6 md:p-8 cart-item" data-product-id="<%= item.product._id %>">

                        <div class="flex flex-col sm:flex-row gap-6">

                            <!-- Product Image -->
                            <div class="sm:w-48 h-48 rounded-2xl flex items-center justify-center overflow-hidden flex-shrink-0"
                                 style="background-color: <%= item.product.bgcolor || '#f4f4f5' %>;">

                                <img
                                    class="h-36 object-contain"
                                    src="<%= item.product.image ? 'data:image/jpeg;base64,' + item.product.image.toString('base64') : '/images/1bag.png' %>"
                                    alt="<%= item.product.name %>">

                            </div>

                            <!-- Product Info & Actions -->
                            <div class="flex-1 flex flex-col justify-between">

                                <div>
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <h3 class="text-xl font-bold text-zinc-900">
                                                <%= item.product.name %>
                                            </h3>
                                            <p class="text-xs uppercase tracking-wider text-zinc-400 font-semibold mt-0.5">
                                                Premium Collection
                                            </p>
                                        </div>

                                        <a
                                            href="/cart/remove/<%= item.product._id %>"
                                            class="text-red-500 hover:text-red-600 text-sm font-medium flex items-center gap-1 transition">
                                            <i class="ri-delete-bin-line"></i>
                                            Remove
                                        </a>
                                    </div>

                                    <div class="mt-4 flex flex-wrap gap-4 text-sm">
                                        <div class="text-zinc-600">
                                            Base Price: <span class="font-semibold text-zinc-900">₹<%= item.product.price %></span>
                                        </div>
                                        <% if (Number(item.product.discount) > 0) { %>
                                            <div class="text-emerald-600 font-medium">
                                                Discount: -₹<%= Number(item.product.discount) %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Quantity Controls & Line Total -->
                                <div class="flex justify-between items-center mt-6 pt-4 border-t border-zinc-100">

                                    <div class="flex items-center gap-2">
                                        <button
                                            type="button"
                                            data-product-id="<%= item.product._id %>"
                                            class="qty-btn decrease w-9 h-9 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-700 transition flex items-center justify-center font-bold">
                                            <i class="ri-subtract-line"></i>
                                        </button>

                                        <span class="w-10 text-center font-bold text-zinc-900 qty-value" data-product-id="<%= item.product._id %>">
                                            <%= item.quantity || 1 %>
                                        </span>

                                        <button
                                            type="button"
                                            data-product-id="<%= item.product._id %>"
                                            class="qty-btn increase w-9 h-9 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-700 transition flex items-center justify-center font-bold">
                                            <i class="ri-add-line"></i>
                                        </button>
                                    </div>

                                    <div class="text-right">
                                        <span class="text-xs text-zinc-400 block uppercase">Subtotal</span>
                                        <span class="text-xl font-bold text-zinc-900">
                                            ₹ <span class="item-subtotal" data-product-id="<%= item.product._id %>">
                                                <%= (Number(item.product.price) - Number(item.product.discount || 0)) * (Number(item.quantity) || 1) %>
                                            </span>
                                        </span>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

            <!-- Order Summary Sidebar -->
            <div class="lg:w-[32%]">

                <div class="sticky top-28 bg-white rounded-3xl border border-zinc-200/80 shadow-sm p-8">

                    <h2 class="text-2xl font-bold text-zinc-900 mb-6 pb-4 border-b border-zinc-100">
                        Order Summary
                    </h2>

                    <div class="space-y-4 text-sm">

                        <div class="flex justify-between text-zinc-600">
                            <span>Cart Total</span>
                            <span class="font-semibold text-zinc-900">
                                ₹ <span id="items-total"><%= itemsTotal %></span>
                            </span>
                        </div>

                        <div class="flex justify-between text-zinc-600">
                            <span>Shipping</span>
                            <span class="text-emerald-600 font-semibold uppercase tracking-wider text-xs bg-emerald-50 px-2 py-0.5 rounded">
                                FREE
                            </span>
                        </div>

                        <div class="flex justify-between text-zinc-600">
                            <span>Platform Fee</span>
                            <span class="font-semibold text-zinc-900">
                                ₹ 20
                            </span>
                        </div>

                    </div>

                    <div class="w-full h-px bg-zinc-200 my-6"></div>

                    <div class="flex justify-between items-baseline mb-8">
                        <span class="text-base font-semibold text-zinc-800">
                            Total Payable
                        </span>
                        <span class="text-3xl font-extrabold text-zinc-900">
                            ₹ <span id="bill-total"><%= bill %></span>
                        </span>
                    </div>

                    <!-- Checkout Form -->
                    <form action="/cart/checkout" method="post">
                        <button
                            type="submit"
                            class="w-full py-4 bg-zinc-900 text-white rounded-2xl font-semibold hover:bg-black transition shadow-lg flex items-center justify-center gap-2 cursor-pointer">
                            <i class="ri-shield-check-line text-lg"></i>
                            Place Order (Cash On Delivery)
                        </button>
                    </form>

                    <div class="mt-4 flex items-center justify-center gap-2 text-xs text-zinc-400">
                        <i class="ri-lock-2-line"></i>
                        <span>Guaranteed Safe & Secure Checkout</span>
                    </div>

                </div>

            </div>

        </div>
    <% } %>

</div>

<script>
document.addEventListener('click', async function(e){
    const btn = e.target.closest('.qty-btn');
    if (!btn) return;
    const productId = btn.dataset.productId;
    const action = btn.classList.contains('increase') ? 'increase' : 'decrease';
    
    // Temporarily disable buttons for this item to prevent spamming
    const itemButtons = document.querySelectorAll(`.qty-btn[data-product-id="${productId}"]`);
    itemButtons.forEach(b => b.disabled = true);

    try {
        const res = await fetch('/cart/update-quantity', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ productId, action })
        });
        const data = await res.json();
        if (!data.success) return;

        const qtyEl = document.querySelector(`.qty-value[data-product-id="${productId}"]`);
        if (qtyEl) qtyEl.textContent = data.itemQuantity;

        const subEl = document.querySelector(`.item-subtotal[data-product-id="${productId}"]`);
        if (subEl) subEl.textContent = data.itemSubtotal;

        const itemsTotalEl = document.getElementById('items-total');
        if (itemsTotalEl) itemsTotalEl.textContent = data.itemsTotal;

        const billEl = document.getElementById('bill-total');
        if (billEl) billEl.textContent = data.bill;

        if (data.removed) {
            const cartItem = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
            if (cartItem) cartItem.remove();
            const anyItems = document.querySelectorAll('.cart-item').length;
            if (!anyItems) location.reload();
        }
    } catch (err) {
        console.error("Failed to update cart:", err);
    } finally {
        itemButtons.forEach(b => b.disabled = false);
    }
});
</script>

<%- include('./partials/footer') %>