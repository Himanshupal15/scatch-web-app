<%- include('./partials/header') %>

<div class="pt-24"></div>

<div class="w-full flex-1 bg-[#FAFAFA] px-6 lg:px-16 py-10">

    <div class="flex flex-col lg:flex-row gap-10">

        <!-- Sidebar -->
        <aside class="lg:w-[24%]">

            <div class="bg-white rounded-3xl border border-zinc-200/80 shadow-sm p-8 sticky top-28">

                <div class="mb-6 pb-6 border-b border-zinc-100">
                    <span class="text-xs uppercase font-bold tracking-widest text-blue-600 block mb-1">
                        Control Center
                    </span>
                    <h2 class="text-2xl font-bold text-zinc-900">
                        Admin Portal
                    </h2>
                    <% if (typeof owner !== 'undefined' && owner) { %>
                        <p class="text-xs text-zinc-400 mt-1">Logged in as <%= owner.fullname %></p>
                    <% } %>
                </div>

                <div class="flex flex-col space-y-2 text-sm font-medium">

                    <a
                        class="px-4 py-3 rounded-xl bg-zinc-900 text-white flex items-center justify-between shadow-sm"
                        href="/owners/admin">
                        <span class="flex items-center gap-2">
                            <i class="ri-archive-line"></i>
                            All Products
                        </span>
                        <span class="bg-zinc-800 text-xs px-2 py-0.5 rounded-full"><%= products.length %></span>
                    </a>

                    <a
                        class="px-4 py-3 rounded-xl text-zinc-700 hover:bg-zinc-100 transition flex items-center gap-2"
                        href="/owners/create-product">
                        <i class="ri-add-circle-line text-blue-600"></i>
                        Create New Product
                    </a>

                    <a
                        class="px-4 py-3 rounded-xl text-zinc-700 hover:bg-zinc-100 transition flex items-center gap-2"
                        href="/shop">
                        <i class="ri-store-2-line"></i>
                        View Customer Store
                    </a>

                    <div class="pt-4 mt-2 border-t border-zinc-100">
                        <a
                            class="px-4 py-3 rounded-xl text-red-600 hover:bg-red-50 transition flex items-center gap-2"
                            href="/owners/logout">
                            <i class="ri-logout-box-r-line"></i>
                            Admin Logout
                        </a>
                    </div>

                </div>

            </div>

        </aside>

        <!-- Main Product Grid -->
        <main class="lg:w-[76%]">

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">

                <div>
                    <h1 class="text-3xl font-bold text-zinc-900">
                        Inventory Catalog
                    </h1>
                    <p class="text-sm text-zinc-500 mt-1">
                        Manage products available in the Scatch boutique.
                    </p>
                </div>

                <div class="flex items-center gap-3">
                    <% if (products.length > 0) { %>
                        <a
                            onclick="return confirm('⚠️ Are you sure you want to delete ALL products? This cannot be undone.')"
                            class="px-4 py-2.5 bg-red-50 text-red-600 border border-red-200 rounded-xl hover:bg-red-100 transition text-sm font-medium flex items-center gap-1.5"
                            href="/products/delete-all">
                            <i class="ri-delete-bin-2-line"></i>
                            Delete All
                        </a>
                    <% } %>

                    <a
                        class="px-5 py-2.5 bg-zinc-900 text-white rounded-xl hover:bg-black transition text-sm font-medium flex items-center gap-1.5 shadow-md"
                        href="/owners/create-product">
                        <i class="ri-add-line"></i>
                        Add Product
                    </a>
                </div>

            </div>

            <!-- Product Grid -->
            <% if (products.length === 0) { %>
                <div class="bg-white rounded-3xl border border-dashed border-zinc-300 p-16 text-center">
                    <div class="w-16 h-16 mx-auto rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-2xl mb-4">
                        <i class="ri-shopping-bag-line"></i>
                    </div>
                    <h3 class="text-xl font-bold text-zinc-800 mb-2">No products in inventory</h3>
                    <p class="text-sm text-zinc-500 mb-6 max-w-md mx-auto">
                        Add your first bag to start selling, or run the seed command to populate starter inventory.
                    </p>
                    <a
                        href="/owners/create-product"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-900 text-white rounded-xl text-sm font-medium hover:bg-black transition">
                        <i class="ri-add-line"></i>
                        Create First Product
                    </a>
                </div>
            <% } else { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">

                    <% products.forEach(function(product) { %>

                        <div class="bg-white rounded-2xl overflow-hidden border border-zinc-200/80 shadow-sm hover:shadow-lg transition flex flex-col justify-between">

                            <!-- Image Container -->
                            <div class="w-full h-56 flex items-center justify-center relative overflow-hidden"
                                 style="background-color: <%= product.bgcolor || '#f4f4f5' %>;">

                                <% if (product.discount && Number(product.discount) > 0) { %>
                                    <span class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow">
                                        ₹<%= product.discount %> OFF
                                    </span>
                                <% } %>

                                <img
                                    class="h-40 object-contain"
                                    src="<%= product.image ? 'data:image/jpeg;base64,' + product.image.toString('base64') : '/images/1bag.png' %>"
                                    alt="<%= product.name %>">

                            </div>

                            <!-- Details -->
                            <div class="p-5 flex justify-between items-center"
                                 style="background-color: <%= product.panelcolor || '#ffffff' %>;">

                                <div>
                                    <h3 class="font-bold text-base text-zinc-900 truncate max-w-[170px]" title="<%= product.name %>">
                                        <%= product.name %>
                                    </h3>

                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="text-base font-bold text-zinc-900">
                                            ₹ <%= product.price - (Number(product.discount) || 0) %>
                                        </span>
                                        <% if (Number(product.discount) > 0) { %>
                                            <span class="text-xs text-zinc-400 line-through">
                                                ₹ <%= product.price %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <a
                                    onclick="return confirm('Are you sure you want to delete this product?')"
                                    class="w-10 h-10 rounded-xl bg-red-50 hover:bg-red-500 text-red-600 hover:text-white flex items-center justify-center transition"
                                    title="Delete Product"
                                    href="/products/delete/<%= product._id %>">
                                    <i class="ri-delete-bin-line text-lg"></i>
                                </a>

                            </div>

                        </div>

                    <% }) %>

                </div>
            <% } %>

        </main>

    </div>

</div>

<%- include('./partials/footer') %>