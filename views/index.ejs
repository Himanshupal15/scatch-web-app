<%- include('./partials/header') %>

<div class="pt-24"></div>

<div class="w-full flex-1 flex flex-col md:flex-row bg-[#FAFAFA]">

    <!-- Register Section -->
    <div class="w-full md:w-1/2 flex items-center justify-center px-6 md:px-12 py-12">

        <div class="w-full max-w-md">

            <!-- Branding -->
            <div class="mb-8">

                <span class="uppercase tracking-[0.45em] text-xs text-blue-500 font-semibold">
                    SCATCH
                </span>

                <h3 class="text-3xl md:text-4xl font-bold text-zinc-900 mt-2">
                    Create Your Account
                </h3>

                <p class="text-zinc-500 mt-2 leading-relaxed text-sm md:text-base">
                    Join Scatch and explore premium bags designed for modern lifestyles.
                </p>

            </div>

            <form autocomplete="off" action="/users/register" method="post">

                <input
                    autocomplete="name"
                    class="w-full px-4 py-3 mb-4 bg-white border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
                    type="text"
                    placeholder="Full Name"
                    name="fullname"
                    required>

                <input
                    autocomplete="email"
                    class="w-full px-4 py-3 mb-4 bg-white border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
                    type="email"
                    placeholder="Email Address"
                    name="email"
                    required>

                <input
                    autocomplete="new-password"
                    class="w-full px-4 py-3 mb-6 bg-white border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
                    type="password"
                    placeholder="Create Password (min 6 characters)"
                    name="password"
                    minlength="6"
                    required>

                <input
                    class="w-full py-3.5 bg-blue-600 text-white rounded-xl font-medium hover:bg-blue-700 transition cursor-pointer shadow-md"
                    type="submit"
                    value="Create My Account">

            </form>

        </div>

    </div>

    <!-- Divider -->
    <div class="hidden md:block w-px bg-zinc-200 my-16"></div>

    <!-- Login Section -->
    <div class="w-full md:w-1/2 flex items-center justify-center px-6 md:px-12 py-12 bg-zinc-50/50 md:bg-transparent">

        <div class="w-full max-w-md">

            <!-- Branding -->
            <div class="mb-8">

                <span class="uppercase tracking-[0.45em] text-xs text-blue-500 font-semibold">
                    SCATCH
                </span>

                <h3 class="text-3xl md:text-4xl font-bold text-zinc-900 mt-2">
                    Welcome Back
                </h3>

                <p class="text-zinc-500 mt-2 leading-relaxed text-sm md:text-base">
                    Sign in to continue your shopping experience.
                </p>

            </div>

            <form autocomplete="off" action="/users/login" method="post">

                <input
                    autocomplete="username"
                    class="w-full px-4 py-3 mb-4 bg-white border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
                    type="email"
                    placeholder="Email Address"
                    name="email"
                    required>

                <input
                    autocomplete="current-password"
                    class="w-full px-4 py-3 mb-6 bg-white border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
                    type="password"
                    placeholder="Enter Password"
                    name="password"
                    required>

                <input
                    class="w-full py-3.5 bg-zinc-900 text-white rounded-xl font-medium hover:bg-black transition cursor-pointer shadow-md"
                    type="submit"
                    value="Login">

            </form>

            <div class="mt-6 text-center">
                <a href="/owners/login" class="text-xs text-zinc-400 hover:text-zinc-600 transition">Store Owner? Access Admin Dashboard &rarr;</a>
            </div>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>