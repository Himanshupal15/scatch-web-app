# Server Port
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Examples:
# Local: mongodb://127.0.0.1:27017/scatch
# Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/scatch?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/scatch

# Session Secret Key (use a strong random string in production)
EXPRESS_SESSION_SECRET=scatch_session_secret_key_change_in_production

# JWT Key for user and owner tokens (use a strong random string in production)
JWT_KEY=scatch_jwt_secret_key_change_in_production
